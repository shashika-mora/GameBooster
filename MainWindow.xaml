<Window x:Class="GameBooster.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="Root" Background="{ThemeResource WindowBrush}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{ThemeResource SidebarBrush}" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,1,0" Padding="18,28,12,22">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="12" Margin="7,0">
          <Border Background="{ThemeResource BrandBrush}" CornerRadius="11" Width="40" Height="40"><TextBlock Text="G" Foreground="{ThemeResource AccentButtonTextBrush}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel><TextBlock Text="GameBooster" Style="{StaticResource SectionTitleStyle}" FontSize="18"/><TextBlock Text="PLAY. RESTORE. REPEAT." Foreground="{ThemeResource SecondaryTextBrush}" FontSize="9" CharacterSpacing="90"/></StackPanel>
        </StackPanel>
        <NavigationView x:Name="Navigation" Grid.Row="1" Margin="-8,30,0,0" Background="Transparent" PaneDisplayMode="Left" IsPaneOpen="True" IsPaneToggleButtonVisible="False" OpenPaneLength="210" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" SelectionChanged="Navigation_SelectionChanged">
          <NavigationView.MenuItems>
            <NavigationViewItem Content="Dashboard" Tag="Dashboard" Icon="Home"/>
            <NavigationViewItem Content="Games" Tag="Games" Icon="Library"/>
            <NavigationViewItem Content="Profiles" Tag="Profiles" Icon="Edit"/>
            <NavigationViewItem Content="Gaming setup" Tag="Setup" Icon="Play"/>
            <NavigationViewItem Content="Sessions" Tag="Sessions" Icon="Clock"/>
            <NavigationViewItem Content="System monitor" Tag="Monitor" Icon="View"/>
            <NavigationViewItem Content="Settings" Tag="Settings" Icon="Setting"/>
          </NavigationView.MenuItems>
        </NavigationView>
        <StackPanel Grid.Row="2" Margin="7,0" Spacing="5"><TextBlock Text="●  Offline and private" Foreground="{ThemeResource SuccessBrush}" FontSize="12"/><TextBlock Text="Your games. Your settings." Foreground="{ThemeResource SecondaryTextBrush}" FontSize="11"/></StackPanel>
      </Grid>
    </Border>
    <ScrollViewer x:Name="MainScroller" Grid.Column="1" Padding="32,30,38,38" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="22">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="MAKE ROOM FOR PLAY" Foreground="{ThemeResource AccentTextBrush}" FontSize="10" CharacterSpacing="130"/><TextBlock x:Name="PageTitle" Text="Dashboard" Style="{StaticResource SectionTitleStyle}" FontSize="32" Margin="0,4,0,0"/></StackPanel>
          <TextBlock x:Name="StateText" Grid.Column="1" Text="●  Ready to play" Foreground="{ThemeResource SuccessBrush}" VerticalAlignment="Center" Margin="18,0,0,0"/>
        </Grid>
        <InfoBar x:Name="Notice" IsOpen="False" CloseButtonClick="Notice_Close"/>
        <Border x:Name="RecoveryPanel" Visibility="Collapsed" Background="{ThemeResource WarningSurfaceBrush}" Padding="20" CornerRadius="12">
          <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="6"><TextBlock Text="A session needs recovery" Foreground="{ThemeResource WarningTextBrush}" FontWeight="SemiBold"/><TextBlock x:Name="RecoveryText" Foreground="{ThemeResource WarningTextBrush}" TextWrapping="Wrap"/></StackPanel>
            <Button Grid.Column="1" Content="Restore saved settings" Click="Recover_Click" VerticalAlignment="Center"/>
          </Grid>
        </Border>

        <StackPanel x:Name="DashboardView" Spacing="22">
          <Border Background="{ThemeResource HeroBrush}" CornerRadius="16" Padding="30">
            <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
              <StackPanel Spacing="12"><TextBlock Text="A better start to your session." FontSize="30" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" TextWrapping="Wrap"/><TextBlock Text="Choose a game, review what changes, and play. Your original settings are restored when the session ends." Style="{StaticResource BodyStyle}"/><Button Content="Open game library  →" Click="OpenGames_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" Margin="0,6,0,0"/></StackPanel>
              <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center"><TextBlock Text="SESSION STATUS" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="10" CharacterSpacing="80"/><TextBlock x:Name="HeroState" Text="Standby" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="HeroGames" Style="{StaticResource BodyStyle}"/></StackPanel>
            </Grid>
          </Border>
          <Border x:Name="ActiveSessionPanel" Style="{StaticResource CardStyle}" Visibility="Collapsed"><StackPanel Spacing="8"><TextBlock Text="Now playing" Foreground="{ThemeResource AccentTextBrush}"/><TextBlock x:Name="ActiveSessionText" Style="{StaticResource SectionTitleStyle}"/><TextBlock x:Name="ActiveSessionDetails" Style="{StaticResource BodyStyle}"/></StackPanel></Border>
          <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="10"><TextBlock Text="SYSTEM CPU" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="11"/><TextBlock x:Name="CpuText" Text="—" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="28"/><ProgressBar x:Name="CpuBar" Maximum="100"/></StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel Spacing="10"><TextBlock Text="MEMORY IN USE" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="11"/><TextBlock x:Name="MemoryText" Text="—" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="28"/><ProgressBar x:Name="MemoryBar" Maximum="100"/></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}"><StackPanel Spacing="10"><TextBlock Text="POWER PLAN" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="11"/><TextBlock x:Name="PowerText" Text="Checking…" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="18" TextWrapping="Wrap"/></StackPanel></Border>
          </Grid>
          <Grid ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="14"><Grid><TextBlock Text="Your games" Style="{StaticResource SectionTitleStyle}"/><Button Content="View all →" Click="OpenGames_Click" HorizontalAlignment="Right"/></Grid><TextBlock x:Name="EmptyDashboardGames" Text="Add your first game to get started." Style="{StaticResource BodyStyle}"/><ItemsControl x:Name="RecentGames"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="{ThemeResource PrimaryTextBrush}" Margin="0,7"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel Spacing="14"><Grid><TextBlock Text="Recent sessions" Style="{StaticResource SectionTitleStyle}"/><Button Content="History →" Click="OpenSessions_Click" HorizontalAlignment="Right"/></Grid><TextBlock x:Name="EmptyDashboardSessions" Text="Your next session starts here." Style="{StaticResource BodyStyle}"/><ItemsControl x:Name="RecentSessions"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,7"><TextBlock Text="{Binding GameName}" Foreground="{ThemeResource PrimaryTextBrush}"/><TextBlock Text="{Binding StatusLabel}" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="12"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
          </Grid>
          <Border Style="{StaticResource CardStyle}"><Grid ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="6"><TextBlock Text="Get Windows ready for gaming" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Review Game Mode, graphics, display settings, and background recording." Style="{StaticResource BodyStyle}"/></StackPanel><Button Grid.Column="1" Content="Review gaming setup" Click="OpenSetup_Click" VerticalAlignment="Center"/></Grid></Border>
        </StackPanel>

        <StackPanel x:Name="GamesView" Visibility="Collapsed" Spacing="18">
          <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="GameSearch" PlaceholderText="Search your library" TextChanged="GameSearch_TextChanged" AutomationProperties.Name="Search games"/><Button Grid.Column="1" Content="Scan Steam" Click="ScanSteam_Click"/><Button Grid.Column="2" Content="Add game" Click="AddGame_Click" Style="{StaticResource AccentButtonStyle}"/></Grid>
          <TextBlock x:Name="EmptyLibraryText" Text="Your library is empty. Add a game or scan your Steam libraries." Style="{StaticResource BodyStyle}"/>
          <ListView x:Name="GamesList" SelectionChanged="GamesList_SelectionChanged" SelectionMode="Single" MaxHeight="420" Background="Transparent">
            <ListView.ItemTemplate><DataTemplate><Grid Padding="10" ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="40" Height="40" CornerRadius="10" Background="{ThemeResource BrandBrush}"><TextBlock Text="{Binding Initial}" Foreground="{ThemeResource AccentButtonTextBrush}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="16"/><TextBlock Text="{Binding SourceLabel}" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="12"/></StackPanel><TextBlock Grid.Column="2" Text="›" Foreground="{ThemeResource AccentTextBrush}" FontSize="24"/></Grid></DataTemplate></ListView.ItemTemplate>
          </ListView>
          <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="14"><TextBlock Text="Selected game" Style="{StaticResource SectionTitleStyle}"/><TextBlock x:Name="SelectedGameText" Text="Select a game from your library." Style="{StaticResource BodyStyle}"/><TextBlock x:Name="SelectedProfileSummary" Style="{StaticResource BodyStyle}"/><StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="LaunchButton" Content="Launch game" Click="Launch_Click" Style="{StaticResource AccentButtonStyle}"/><Button Content="Edit profile" Click="EditSelectedProfile_Click"/><Button Content="Set executable" Click="SetExecutable_Click"/><Button Content="Remove" Click="RemoveGame_Click"/></StackPanel></StackPanel></Border>
        </StackPanel>

        <StackPanel x:Name="ProfilesView" Visibility="Collapsed" Spacing="20" MaxWidth="760" HorizontalAlignment="Left">
          <TextBlock Text="A profile for the way you play" Style="{StaticResource SectionTitleStyle}"/>
          <TextBlock Text="Review every setting before launch. Defaults leave Windows in control. Power and CPU changes are saved and restored after the session." Style="{StaticResource BodyStyle}"/>
          <ComboBox x:Name="ProfileGame" Header="Game" DisplayMemberPath="Name" SelectionChanged="ProfileGame_SelectionChanged" HorizontalAlignment="Stretch"/>
          <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="16">
            <ComboBox x:Name="Preset" Header="Preset" SelectionChanged="Preset_SelectionChanged" HorizontalAlignment="Stretch"><ComboBoxItem Content="Balanced — keep current settings" Tag="Balanced"/><ComboBoxItem x:Name="PerformancePreset" Content="Performance — High performance power plan" Tag="Performance"/><ComboBoxItem Content="Custom — choose each setting" Tag="Custom"/></ComboBox>
            <ComboBox x:Name="Scheme" Header="Power plan during play" DisplayMemberPath="Name" HorizontalAlignment="Stretch"/>
            <TextBlock Text="Performance plans can use more battery and produce more heat. Results depend on your game and hardware." Style="{StaticResource BodyStyle}"/>
            <ComboBox x:Name="Priority" Header="Game CPU priority" SelectionChanged="OptionalProfileSetting_Changed" HorizontalAlignment="Stretch"><ComboBoxItem Content="Default — let the game decide" Tag="Unchanged"/><ComboBoxItem Content="Above normal — prefer game CPU time" Tag="AboveNormal"/></ComboBox>
            <TextBlock Text="Above normal may help when CPU tasks compete, and can reduce background responsiveness. It does not guarantee higher FPS. Protected games may refuse the change." Style="{StaticResource BodyStyle}"/>
            <CheckBox x:Name="KeepAwake" Content="Prevent automatic idle sleep during this session" Checked="OptionalProfileSetting_Changed" Unchecked="OptionalProfileSetting_Changed"/>
            <TextBlock Text="Keeps the display and PC awake while you play. Uses extra power; manual sleep and Windows battery limits still apply." Style="{StaticResource BodyStyle}"/>
            <Button x:Name="SaveProfileButton" Content="Save profile" Click="SaveProfile_Click" Style="{StaticResource AccentButtonStyle}"/>
          </StackPanel></Border>
        </StackPanel>

        <StackPanel x:Name="SessionsView" Visibility="Collapsed" Spacing="18">
          <TextBlock Text="Your sessions, with nothing hidden" Style="{StaticResource SectionTitleStyle}"/>
          <TextBlock x:Name="EmptySessionsText" Text="Completed sessions and restoration results will appear here." Style="{StaticResource BodyStyle}"/>
          <ListView x:Name="SessionsList" SelectionChanged="SessionsList_SelectionChanged" MaxHeight="360" Background="Transparent"><ListView.ItemTemplate><DataTemplate><Grid Padding="12" ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="160"/><ColumnDefinition Width="145"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding GameName}" Foreground="{ThemeResource PrimaryTextBrush}" FontWeight="SemiBold"/><TextBlock Text="{Binding ProfilePreset}" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="12"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding StartedLabel}" Foreground="{ThemeResource SecondaryTextBrush}"/><TextBlock Text="{Binding DurationLabel}" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="12"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding StatusLabel}" Foreground="{ThemeResource PrimaryTextBrush}" TextWrapping="Wrap"/></Grid></DataTemplate></ListView.ItemTemplate></ListView>
          <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="14"><TextBlock Text="What changed and what was restored" Style="{StaticResource SectionTitleStyle}"/><TextBlock x:Name="SessionRestorationText" Text="Select a session to see its details." Style="{StaticResource BodyStyle}"/><ItemsControl x:Name="OperationsList"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Spacing="4" Margin="0,8"><TextBlock Text="{Binding Name}" Foreground="{ThemeResource PrimaryTextBrush}" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" Foreground="{ThemeResource AccentTextBrush}" FontSize="12"/><TextBlock Text="{Binding Detail}" Style="{StaticResource BodyStyle}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
        </StackPanel>

        <StackPanel x:Name="MonitorView" Visibility="Collapsed" Spacing="18">
          <TextBlock Text="A clear view of your system" Style="{StaticResource SectionTitleStyle}"/>
          <TextBlock x:Name="SamplingText" Style="{StaticResource BodyStyle}"/>
          <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="18"><TextBlock x:Name="MonitorCpu" Style="{StaticResource SectionTitleStyle}"/><ProgressBar x:Name="MonitorCpuBar" Maximum="100"/><TextBlock x:Name="MonitorMemory" Style="{StaticResource SectionTitleStyle}"/><ProgressBar x:Name="MonitorMemoryBar" Maximum="100"/><TextBlock Text="These are total system readings. GPU, temperature, and FPS are not measured." Style="{StaticResource BodyStyle}"/></StackPanel></Border>
        </StackPanel>

        <StackPanel x:Name="SetupView" Visibility="Collapsed" Spacing="18">
          <TextBlock Text="Make the most of Windows gaming settings" Style="{StaticResource SectionTitleStyle}"/>
          <TextBlock Text="These checks open Windows settings for you to review. Availability and benefits depend on Windows, your game, and your hardware." Style="{StaticResource BodyStyle}"/>
          <ItemsControl x:Name="GamingSetupList"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource CardStyle}" Margin="0,0,0,12"><Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="7"><TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{Binding Description}" Style="{StaticResource BodyStyle}"/></StackPanel><Button Grid.Column="1" Content="Open settings ↗" Tag="{Binding Key}" Click="OpenWindowsSetting_Click" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>

        <StackPanel x:Name="SettingsView" Visibility="Collapsed" Spacing="18" MaxWidth="760" HorizontalAlignment="Left">
          <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="16"><TextBlock Text="Make yourself at home" Style="{StaticResource SectionTitleStyle}"/><ComboBox x:Name="ThemeSelector" Header="Appearance" SelectionChanged="Appearance_Changed" HorizontalAlignment="Stretch"><ComboBoxItem Content="Use system setting" Tag="System"/><ComboBoxItem Content="Light" Tag="Light"/><ComboBoxItem Content="Dark" Tag="Dark"/></ComboBox><TextBlock Text="Your choice is saved and applied across the app." Style="{StaticResource BodyStyle}"/></StackPanel></Border>
          <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="16"><TextBlock Text="Monitoring" Style="{StaticResource SectionTitleStyle}"/><ComboBox x:Name="SamplingSelector" Header="Refresh interval" SelectionChanged="Appearance_Changed" HorizontalAlignment="Stretch"><ComboBoxItem Content="Standard · every 3 seconds" Tag="3"/><ComboBoxItem Content="Relaxed · every 5 seconds" Tag="5"/><ComboBoxItem Content="Minimal · every 10 seconds" Tag="10"/></ComboBox><TextBlock Text="During gameplay, readings refresh at most once every five seconds to keep GameBooster lightweight." Style="{StaticResource BodyStyle}"/></StackPanel></Border>
          <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Text="Your data stays with you" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Works offline. No account, usage uploads, or subscription. Your library, profiles, and session history stay on this computer." Style="{StaticResource BodyStyle}"/><TextBlock Text="Data folder" Foreground="{ThemeResource SecondaryTextBrush}"/><TextBlock x:Name="SettingsStorage" Foreground="{ThemeResource PrimaryTextBrush}" IsTextSelectionEnabled="True" TextWrapping="Wrap"/><TextBlock Text="Current power plan" Foreground="{ThemeResource SecondaryTextBrush}"/><TextBlock x:Name="SettingsPower" Foreground="{ThemeResource PrimaryTextBrush}"/><TextBlock Text="Closing GameBooster restores active session settings while leaving the game running. After an interruption, saved settings remain available for recovery." Style="{StaticResource BodyStyle}"/></StackPanel></Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
