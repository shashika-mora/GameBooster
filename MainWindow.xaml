<Window
    x:Class="GameBooster.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Title="GameBooster">
  <Grid Background="#10151D">
    <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#151C27" Padding="24,28">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Border Width="38" Height="38" CornerRadius="10" Background="#7C5CFC"><TextBlock Text="G" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel><TextBlock Text="GameBooster" Foreground="White" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="SESSION CONTROL" Foreground="#8A94A6" FontSize="10" CharacterSpacing="90"/></StackPanel>
        </StackPanel>
        <muxc:NavigationView x:Name="Navigation" Grid.Row="1" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" PaneDisplayMode="LeftCompact" SelectionChanged="Navigation_SelectionChanged" Background="Transparent" Margin="-12,32,0,0">
          <muxc:NavigationView.MenuItems>
            <muxc:NavigationViewItem Content="Dashboard" Tag="Dashboard" Icon="Home"/>
            <muxc:NavigationViewItem Content="Games" Tag="Games" Icon="Library"/>
            <muxc:NavigationViewItem Content="Profiles" Tag="Profiles" Icon="Edit"/>
            <muxc:NavigationViewItem Content="Sessions" Tag="Sessions" Icon="History"/>
            <muxc:NavigationViewItem Content="System Monitor" Tag="Monitor" Icon="SpeedHigh"/>
          </muxc:NavigationView.MenuItems>
        </muxc:NavigationView>
        <StackPanel Grid.Row="2" Spacing="6"><TextBlock Text="●  Offline by design" Foreground="#6EE7B7" FontSize="12"/><TextBlock Text="Native Windows build · v1.0" Foreground="#7F8A9D" FontSize="11"/></StackPanel>
      </Grid>
    </Border>
    <ScrollViewer Grid.Column="1" Padding="42,34,52,42">
      <StackPanel Spacing="24">
        <Grid><StackPanel><TextBlock Text="GAME SESSION MANAGEMENT" Foreground="#9B8AFB" FontSize="11" CharacterSpacing="120"/><TextBlock x:Name="PageTitle" Text="Dashboard" Foreground="White" FontSize="32" FontWeight="SemiBold"/></StackPanel><TextBlock x:Name="StateText" Text="●  System ready" Foreground="#6EE7B7" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="13"/></Grid>
        <InfoBar x:Name="Notice" IsOpen="False" Severity="Informational" CloseButtonClick="Notice_Close"/>
        <Border x:Name="RecoveryPanel" Visibility="Collapsed" Background="#372619" CornerRadius="12" Padding="18"><Grid><StackPanel><TextBlock Text="Unfinished session needs recovery" Foreground="#FBBF24" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="RecoveryText" Foreground="#D8C6A1" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel><Button Content="Restore saved state" Click="Recover_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource AccentButtonStyle}"/></Grid></Border>
        <Grid x:Name="DashboardView" RowSpacing="22">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Background="#1C2635" CornerRadius="16" Padding="30"><Grid><StackPanel><TextBlock Text="READY WHEN YOU ARE" Foreground="#9B8AFB" FontSize="11" CharacterSpacing="100"/><TextBlock Text="Play with a plan." Foreground="White" FontSize="30" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock Text="Return to normal." Foreground="#A99CFF" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Launch games with explicit, reversible Windows settings. GameBooster restores your original power plan when the session ends." Foreground="#A8B2C1" TextWrapping="Wrap" MaxWidth="560" Margin="0,14,0,20"/><Button Content="Open game library  →" Click="OpenGames_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left"/></StackPanel><StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="CURRENT STATE" Foreground="#8A94A6" FontSize="11" CharacterSpacing="100"/><TextBlock x:Name="HeroState" Text="Standby" Foreground="White" FontSize="24" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock x:Name="HeroGames" Foreground="#A8B2C1" Margin="0,5,0,0"/></StackPanel></Grid></Border>
          <StackPanel Grid.Row="1"><TextBlock Text="System at a glance" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#1A2330" CornerRadius="12" Padding="18"><StackPanel><TextBlock Text="CPU" Foreground="#8A94A6"/><TextBlock x:Name="CpuText" Text="0%" Foreground="White" FontSize="26" FontWeight="SemiBold" Margin="0,7,0,0"/><ProgressBar x:Name="CpuBar" Minimum="0" Maximum="100" Height="4" Margin="0,10,0,0"/></StackPanel></Border><Border Grid.Column="1" Background="#1A2330" CornerRadius="12" Padding="18"><StackPanel><TextBlock Text="MEMORY" Foreground="#8A94A6"/><TextBlock x:Name="MemoryText" Text="0 GB" Foreground="White" FontSize="26" FontWeight="SemiBold" Margin="0,7,0,0"/><ProgressBar x:Name="MemoryBar" Minimum="0" Maximum="100" Height="4" Margin="0,10,0,0"/></StackPanel></Border><Border Grid.Column="2" Background="#1A2330" CornerRadius="12" Padding="18"><StackPanel><TextBlock Text="POWER PLAN" Foreground="#8A94A6"/><TextBlock x:Name="PowerText" Text="Loading…" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,13,0,0"/></StackPanel></Border></Grid></StackPanel>
          <Grid Grid.Row="2" ColumnSpacing="22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#1A2330" CornerRadius="12" Padding="20"><StackPanel><Grid><TextBlock Text="Your games" Foreground="White" FontSize="17" FontWeight="SemiBold"/><Button Content="View all  →" Click="OpenGames_Click" HorizontalAlignment="Right" Background="Transparent"/></Grid><ItemsControl x:Name="RecentGames" Margin="0,15,0,0"/></StackPanel></Border><Border Grid.Column="1" Background="#1A2330" CornerRadius="12" Padding="20"><StackPanel><Grid><TextBlock Text="Recent sessions" Foreground="White" FontSize="17" FontWeight="SemiBold"/><Button Content="History  →" Click="OpenSessions_Click" HorizontalAlignment="Right" Background="Transparent"/></Grid><ItemsControl x:Name="RecentSessions" Margin="0,15,0,0"/></StackPanel></Border></Grid>
        </Grid>
        <StackPanel x:Name="GamesView" Visibility="Collapsed" Spacing="18"><Grid><TextBlock Text="Game library" Foreground="White" FontSize="22" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"><Button Content="Scan Steam" Click="ScanSteam_Click"/><Button Content="Add game" Click="AddGame_Click" Style="{StaticResource AccentButtonStyle}"/></StackPanel></Grid><Border Background="#1A2330" CornerRadius="12" Padding="8"><ListView x:Name="GamesList" SelectionChanged="GamesList_SelectionChanged" Background="Transparent"><ListView.ItemTemplate><DataTemplate><Grid Padding="12"><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="34" Height="34" CornerRadius="9" Background="#7C5CFC"><TextBlock Text="{Binding Name, Mode=OneWay}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="12,0"><TextBlock Text="{Binding Name}" Foreground="White" FontSize="15"/><TextBlock Text="{Binding Source}" Foreground="#8A94A6" FontSize="12"/></StackPanel><TextBlock Grid.Column="2" Text="›" Foreground="#9B8AFB" FontSize="22"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></Border><Border Background="#1A2330" CornerRadius="12" Padding="22"><StackPanel Spacing="12"><TextBlock Text="Selected game" Foreground="White" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="SelectedGameText" Text="Select a game from your library." Foreground="#A8B2C1"/><StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Launch game" Click="Launch_Click" Style="{StaticResource AccentButtonStyle}"/><Button Content="Set executable" Click="SetExecutable_Click"/></StackPanel></StackPanel></Border></StackPanel>
        <StackPanel x:Name="SessionsView" Visibility="Collapsed" Spacing="18"><TextBlock Text="Session history" Foreground="White" FontSize="22" FontWeight="SemiBold"/><Border Background="#1A2330" CornerRadius="12" Padding="12"><ListView x:Name="SessionsList" Background="Transparent"><ListView.ItemTemplate><DataTemplate><Grid Padding="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="180"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding GameName}" Foreground="White"/><TextBlock Text="{Binding ProfilePreset}" Foreground="#8A94A6" FontSize="12"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding StartedAt}" Foreground="#A8B2C1"/><TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="#6EE7B7"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></Border></StackPanel>
        <StackPanel x:Name="ProfilesView" Visibility="Collapsed" Spacing="18"><TextBlock Text="Per-game profiles" Foreground="White" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Balanced makes no system change. Performance uses Windows High performance. Custom accepts an existing scheme GUID." Foreground="#A8B2C1" TextWrapping="Wrap"/><ComboBox x:Name="ProfileGame" Header="Game" SelectionChanged="ProfileGame_SelectionChanged"/><ComboBox x:Name="Preset" Header="Preset"><ComboBoxItem Content="Balanced"/><ComboBoxItem Content="Performance"/><ComboBoxItem Content="Custom"/></ComboBox><TextBox x:Name="Scheme" Header="Windows power scheme GUID" PlaceholderText="Leave blank for no change"/><Button Content="Save profile" Click="SaveProfile_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left"/></StackPanel>
        <StackPanel x:Name="MonitorView" Visibility="Collapsed" Spacing="18"><TextBlock Text="System monitor" Foreground="White" FontSize="22" FontWeight="SemiBold"/><Border Background="#1A2330" CornerRadius="12" Padding="22"><StackPanel Spacing="14"><TextBlock Text="Local system metrics" Foreground="White" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="MonitorCpu" Foreground="#A8B2C1"/><ProgressBar x:Name="MonitorCpuBar" Maximum="100"/><TextBlock x:Name="MonitorMemory" Foreground="#A8B2C1"/><ProgressBar x:Name="MonitorMemoryBar" Maximum="100"/></StackPanel></Border></StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
